# ==========================================================================
# Perspectiva frontend — environment variables
# ==========================================================================
# Copy this file to ".env" for local development:  cp .env.example .env
# On Vercel you do NOT create a .env file — you paste each KEY=VALUE pair
# into Project Settings > Environment Variables instead.
# (Vite only exposes variables that start with VITE_ to the app.)
# See DEPLOYMENT.md for the exact, click-by-click steps.
# --------------------------------------------------------------------------

# Public address of your backend API (the Railway URL), with NO trailing
# slash. Example: https://insight-forge-api-production.up.railway.app
# This is REQUIRED — the site will refuse to start in production without it.
VITE_API_URL=https://your-backend.up.railway.app

# Google OAuth Client ID (OPTIONAL). Must match GOOGLE_CLIENT_ID on the
# backend. Leave blank to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
